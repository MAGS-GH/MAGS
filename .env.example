# Compose indlæser .env fra repo-roden. Produktionsværdier sættes i Dokploy.
NEXT_PUBLIC_CONTACT_EMAIL=mags@mags.dk
MARKETING_PORT=3000

# Forsiden virker med mail som kontaktvej, når booking er slået fra.
# Aktivér profilen og graph, før BOOKING_ENABLED sættes til true.
COMPOSE_PROFILES=
BOOKING_ENABLED=false
BOOKING_MODE=disabled
BOOKING_ASPNETCORE_ENVIRONMENT=Production
BOOKING_DB_PASSWORD=
BOOKING_DATABASE_CONNECTION=
BOOKING_REQUEST_HASH_KEY=
BOOKING_TENANT_ID=
BOOKING_CLIENT_ID=
BOOKING_CLIENT_SECRET=
BOOKING_MAILBOX=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=mags.dk,www.mags.dk
